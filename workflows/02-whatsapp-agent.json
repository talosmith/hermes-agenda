    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.output) return [];\n// no máximo 1 alerta de IA a cada 30 min (evita enxurrada quando a cota do Gemini acaba)\nconst st = $getWorkflowStaticData('global');\nconst agora = Date.now();\nif (st.ultimoAlertaIA && agora - st.ultimoAlertaIA < 30 * 60 * 1000) return [];\nst.ultimoAlertaIA = agora;\nconst e = r.error;\nconst msg = String((e && (e.message || e.description)) || (typeof e === 'string' ? e : 'sem detalhe')).slice(0, 400);\nreturn [{ json: { texto: '⚠️ *Robô da Ana — a IA falhou*\\n\\nO paciente recebeu a mensagem de \"problema técnico\".\\n\\nErro: ' + msg + '\\n\\n(Próximo alerta deste tipo só daqui a 30 min.)' } }];"
