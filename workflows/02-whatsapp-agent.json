    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nconst r = String(msg.texto || '').match(/^#(pausar|voltar)\\s+([+\\d\\s().-]{8,})/i);\nif (!r) return []; // não é comando: ignora (é a própria psicóloga conversando)\nlet alvo = r[2].replace(/\\D/g, '');\nif (alvo.length === 10 || alvo.length === 11) alvo = '55' + alvo;\nlet alvoAlt = alvo;\nif (/^55\\d{11}$/.test(alvo) && alvo[4] === '9') alvoAlt = alvo.slice(0, 4) + alvo.slice(5);\nelse if (/^55\\d{10}$/.test(alvo)) alvoAlt = alvo.slice(0, 4) + '9' + alvo.slice(4);\nconst cmd = r[1].toLowerCase();\nconst dono = (msg.dono || msg.jid).split('@')[0].split(':')[0];\nconst resposta = cmd === 'pausar'\n  ? `⏸️ Assistente pausado para ${alvo} por 30 dias. Para reativar: #voltar ${alvo}`\n  : `▶️ Assistente reativado para ${alvo}.`;\nreturn [{ json: { cmd, alvo, alvoAlt, dono, resposta } }];"
      },
