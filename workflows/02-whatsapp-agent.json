    {
      "parameters": {
        "jsCode": "const body = $('Webhook Evolution').first().json.body || {};\nif (String(body.event || '').toLowerCase().replace('_', '.') !== 'messages.upsert') return [];\nconst d = Array.isArray(body.data) ? body.data[0] : (body.data || {});\nconst key = d.key || {};\nconst jid = String(key.remoteJid || '');\nif (!jid || jid.endsWith('@g.us') || jid.endsWith('@broadcast') || jid.endsWith('@newsletter')) return [];\n\nconst m = d.message || {};\nif (m.reactionMessage || m.protocolMessage || m.editedMessage) return [];\n\n// Contas com \"LID\": o número real pode vir em outro campo\nconst candidatos = [key.remoteJidAlt, key.senderPn, d.senderPn, jid].filter(Boolean).map(String);\nconst comNumero = candidatos.find(j => j.endsWith('@s.whatsapp.net'));\nconst telefone = (comNumero || jid).split('@')[0].split(':')[0];\nconst destino = comNumero ? telefone : jid;\n\n// Variante com/sem o 9º dígito (números brasileiros)\nlet telefoneAlt = telefone;\nif (/^55\\d{11}$/.test(telefone) && telefone[4] === '9') telefoneAlt = telefone.slice(0, 4) + telefone.slice(5);\nelse if (/^55\\d{10}$/.test(telefone)) telefoneAlt = telefone.slice(0, 4) + '9' + telefone.slice(4);\n\nconst texto = String(\n  m.conversation || m.extendedTextMessage?.text || m.imageMessage?.caption || m.videoMessage?.caption ||\n  m.documentMessage?.caption || m.buttonsResponseMessage?.selectedDisplayText || m.listResponseMessage?.title || ''\n).trim();\nlet tipo = 'texto';\nif (!texto) {\n  if (m.audioMessage) tipo = 'audio';\n  else if (m.imageMessage || m.stickerMessage) tipo = 'imagem';\n  else if (m.documentMessage || m.documentWithCaptionMessage) tipo = 'documento';\n  else tipo = 'outro';\n}\nreturn [{ json: {\n  telefone, telefoneAlt, destino, jid,\n  nome: d.pushName || '',\n  texto, tipo,\n  fromMe: !!key.fromMe,\n  dono: String(body.sender || ''),\n} }];"
      },
