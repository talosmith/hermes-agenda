        "query": "INSERT INTO bot_pausa (telefone, ate, motivo) VALUES ($1, now() + interval '30 days', 'pausado pela psicóloga'), ($2, now() + interval '30 days', 'pausado pela psicóloga') ON CONFLICT (telefone) DO UPDATE SET ate = EXCLUDED.ate, motivo = EXCLUDED.motivo;",
        "options": {
          "queryReplacement": "={{ [ $json.alvo, $json.alvoAlt ] }}"
        }
