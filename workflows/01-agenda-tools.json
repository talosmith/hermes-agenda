    {
      "parameters": {
        "jsCode": "const { config, data } = $input.first().json;\nconst tz = config.fuso;\nconst hoje = DateTime.now().setZone(tz).startOf('day');\nlet inicio = data ? DateTime.fromISO(String(data).slice(0, 10), { zone: tz }).startOf('day') : hoje;\nif (!inicio.isValid || inicio < hoje) inicio = hoje;\nconst limite = hoje.plus({ days: config.diasAFrente }).endOf('day');\nlet fim = inicio.plus({ days: data ? 3 : config.diasAFrente }).endOf('day');\nif (fim > limite) fim = limite;\nif (inicio > limite) inicio = limite.startOf('day');\nreturn [{ json: { timeMin: inicio.toISO(), timeMax: fim.toISO() } }];"
      },
      "id": "1c4ddcaf-f35d-43d4-9a01-6246529e7819",
      "name": "Período de busca",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        0
      ]
    },
