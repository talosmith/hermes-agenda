      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const { config, telefone } = $('Config agenda').first().json;\nconst ev = $input.first().json || {};\nconst tz = config.fuso;\nif (!ev.id || !ev.start || !ev.start.dateTime || ev.status === 'cancelled') {\n  return [{ json: { ok: false, resposta: 'Sessão não encontrada. Use meus_agendamentos para pegar o ID correto.' } }];\n}\nif (!telefone || !String(ev.description || '').includes(telefone)) {\n  return [{ json: { ok: false, resposta: 'Essa sessão não pertence a este contato. Não é possível cancelar.' } }];\n}\nconst ini = DateTime.fromISO(ev.start.dateTime).setZone(tz).setLocale('pt-BR');\nconst horas = ini.diff(DateTime.now(), 'hours').hours;\nif (horas <= 0) return [{ json: { ok: false, resposta: 'Essa sessão já aconteceu.' } }];\nif (horas < config.cancelamentoMinHoras) {\n  return [{ json: { ok: false, resposta: `Faltam menos de ${config.cancelamentoMinHoras}h para a sessão. Pela política do consultório, isso precisa ser tratado diretamente com a psicóloga: use chamar_psicologa.` } }];\n}\nreturn [{ json: { ok: true, eventId: ev.id, quandoTexto: ini.toFormat(\"cccc, dd/LL 'às' HH:mm\") } }];"
      },
      "id": "73bc7fc7-d24c-445d-a054-5a2c778f5c43",
      "name": "Checar cancelamento",
      "type": "n8n-nodes-base.code",
