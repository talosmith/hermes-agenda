    {
      "parameters": {
        "jsCode": "const { config, telefone } = $('Config agenda').first().json;\nconst tz = config.fuso;\nconst evs = $input.all().map(i => i.json)\n  .filter(e => e && e.id && e.start && e.start.dateTime && telefone && String(e.description || '').includes(telefone));\nif (!evs.length) return [{ json: { resposta: 'Nenhuma sessão futura encontrada para este contato.' } }];\nconst linhas = evs.slice(0, 8).map(e => {\n  const d = DateTime.fromISO(e.start.dateTime).setZone(tz).setLocale('pt-BR');\n  const mod = ((String(e.description).match(/Modalidade:\\s*([^\\n<]+)/i) || [])[1] || '').trim();\n  return `- ${d.toFormat(\"cccc, dd/LL/yyyy 'às' HH:mm\")}${mod ? ' (' + mod + ')' : ''} | ID: ${e.id}`;\n});\nreturn [{ json: { resposta: 'Próximas sessões deste contato:\\n' + linhas.join('\\n') + '\\n\\n(IDs são internos: nunca mostre ao paciente.)' } }];"
      },
      "id": "dd457052-1c7e-4ffa-b18a-692468c3169d",
      "name": "Filtrar sessões do contato",
      "type": "n8n-nodes-base.code",
