      "id": "a99855d5-0d83-48d8-b8dc-3b0ae10c4567",
      "name": "Eventos do período",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        928,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "GoogleAgenda0001",
          "name": "Google Agenda"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const { config } = $('Config agenda').first().json;\nconst periodo = $('Período de busca').first().json;\nconst tz = config.fuso;\nconst limite = DateTime.now().setZone(tz).plus({ hours: config.antecedenciaMinHoras });\n\nconst ocupados = $input.all().map(i => i.json)\n  .filter(e => e && e.id && e.status !== 'cancelled' && e.transparency !== 'transparent' && e.start)\n  .map(e => e.start.dateTime\n    ? { ini: DateTime.fromISO(e.start.dateTime), fim: DateTime.fromISO(e.end.dateTime) }\n    : { ini: DateTime.fromISO(e.start.date, { zone: tz }), fim: DateTime.fromISO(e.end.date, { zone: tz }) });\n\nconst dias = [];\nlet exemplo = '';\nlet dia = DateTime.fromISO(periodo.timeMin).setZone(tz).startOf('day');\nconst ultimo = DateTime.fromISO(periodo.timeMax).setZone(tz);\nwhile (dia <= ultimo && dias.length < config.maxDiasSugeridos) {\n  const livres = [];\n  for (const h of (config.grade[dia.weekday] || [])) {\n    const [hh, mm] = h.split(':').map(Number);\n    const ini = dia.set({ hour: hh, minute: mm, second: 0, millisecond: 0 });\n    const fim = ini.plus({ minutes: config.duracaoMin });\n    if (ini < limite) continue;\n    if (ocupados.some(o => ini < o.fim && fim > o.ini)) continue;\n    livres.push(h);\n  }\n  if (livres.length) {\n    const d = dia.setLocale('pt-BR');\n    if (!exemplo) exemplo = d.toFormat('yyyy-LL-dd') + 'T' + livres[0];\n    dias.push(`${d.toFormat('cccc, dd/LL')} [data ${d.toFormat('yyyy-LL-dd')}]: ${livres.join(', ')}`);\n  }\n  dia = dia.plus({ days: 1 });\n}\nconst resposta = dias.length\n  ? 'Horários livres (sessões de ' + config.duracaoMin + ' min):\\n' + dias.join('\\n') +\n    '\\n\\nPara agendar use inicio no formato AAAA-MM-DDTHH:mm (ex.: ' + exemplo + ').'\n  : 'Não há horários livres nesse período. Sugira outra data ou ofereça chamar a psicóloga.';\nreturn [{ json: { resposta } }];"
      },
      "id": "0dcefb35-943a-4bda-9de6-d0db19fa344a",
      "name": "Calcular horários livres",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const { config, inicio, nome, modalidade, telefone } = $input.first().json;\nconst tz = config.fuso;\nconst ini = DateTime.fromISO(String(inicio || '').slice(0, 16), { zone: tz });\nlet erro = '';\nif (!ini.isValid) {\n  erro = 'Data/hora inválida. Use o formato AAAA-MM-DDTHH:mm.';\n} else if (!(config.grade[ini.weekday] || []).includes(ini.toFormat('HH:mm'))) {\n  erro = 'Esse horário não faz parte da grade de atendimento. Consulte os horários livres primeiro.';\n} else if (ini < DateTime.now().setZone(tz).plus({ hours: config.antecedenciaMinHoras })) {\n  erro = `É preciso agendar com pelo menos ${config.antecedenciaMinHoras}h de antecedência.`;\n} else if (ini > DateTime.now().setZone(tz).plus({ days: config.diasAFrente }).endOf('day')) {\n  erro = `A agenda só está aberta para os próximos ${config.diasAFrente} dias.`;\n}\nif (!erro && (!nome || String(nome).trim().length < 3)) erro = 'Falta o nome completo do paciente.';\nconst fim = ini.isValid ? ini.plus({ minutes: config.duracaoMin }) : null;\nreturn [{ json: {\n  erro,\n  inicioISO: ini.isValid ? ini.toISO() : '',\n  fimISO: fim ? fim.toISO() : '',\n  quandoTexto: ini.isValid ? ini.setLocale('pt-BR').toFormat(\"cccc, dd/LL 'às' HH:mm\") : '',\n  nome: String(nome || '').trim(),\n  modalidade: String(modalidade || 'não informada').trim(),\n  telefone,\n} }];"
      },
