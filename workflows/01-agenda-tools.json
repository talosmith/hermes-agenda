      "parameters": {
        "jsCode": "// =====================================================================\n//  CONFIGURE AQUI A AGENDA DA PSICÓLOGA\n// =====================================================================\nconst config = {\n  calendarId: 'agenda@example.com', // e-mail/ID da agenda do Google. 'primary' NÃO funciona no n8n\n  fuso: 'America/Sao_Paulo',\n  duracaoMin: 50,                   // duração da sessão em minutos\n  // Horários de INÍCIO das sessões por dia da semana (1=segunda ... 7=domingo)\n  grade: {\n    1: ['08:00', '09:00', '10:00', '14:00', '15:00', '16:00', '17:00', '18:00'],\n    2: ['08:00', '09:00', '10:00', '14:00', '15:00', '16:00', '17:00', '18:00'],\n    3: ['08:00', '09:00', '10:00', '14:00', '15:00', '16:00', '17:00', '18:00'],\n    4: ['08:00', '09:00', '10:00', '14:00', '15:00', '16:00', '17:00', '18:00'],\n    5: ['08:00', '09:00', '10:00', '14:00', '15:00', '16:00'],\n    6: [],\n    7: [],\n  },\n  antecedenciaMinHoras: 12,         // não agenda com menos que isso de antecedência\n  cancelamentoMinHoras: 24,         // abaixo disso, o robô não cancela: passa para a psicóloga\n  diasAFrente: 14,                  // até quantos dias à frente oferecer horários\n  maxDiasSugeridos: 4,              // quantos dias (com vaga) mostrar por consulta\n  pausaHoras: 24,                   // quanto tempo o robô fica pausado ao chamar a psicóloga\n  evolutionUrl: 'http://evolution:8080',\n  instancia: 'consultorio',         // igual ao EVOLUTION_INSTANCE do .env\n  numeroAvisos: '5511999990000',      // WhatsApp que recebe os avisos (ex.: 5511999998888)\n};\nconst entrada = $input.first().json;\nreturn [{ json: { ...entrada, config } }];"
      },
