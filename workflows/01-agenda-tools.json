    {
      "parameters": {
        "jsCode": "const { config, telefone, nome, motivo } = $('Config agenda').first().json;\nconst urgente = /urgente|risco|crise|suic/i.test(String(motivo || ''));\nconst texto = [\n  urgente ? '🚨 *URGENTE — assistente virtual*' : '🔔 *Assistente virtual — atendimento humano solicitado*',\n  '',\n  `Contato: https://wa.me/${telefone}`,\n  `Nome no WhatsApp: ${nome || '-'}`,\n  `Motivo: ${motivo || '-'}`,\n  '',\n  `O robô ficou pausado ${config.pausaHoras}h para este contato.`,\n  `Para reativar antes, envie aqui: #voltar ${telefone}`,\n].join('\\n');\nreturn [{ json: { numero: config.numeroAvisos, texto } }];"
      },
